---
import { Image } from 'astro:assets';
import logo from '@/assets/images/cebra-partners-logo.webp';
import { contactHref, site } from '@/config/site';
import Button from './Button.astro';
---

<header class="sticky top-0 z-40 border-b border-white/10 bg-ink/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-5 sm:px-8">
    <a href="/" class="flex items-center gap-3 text-paper" aria-label={`${site.name} home`}>
      <Image
        src={logo}
        alt=""
        width={32}
        height={32}
        densities={[1, 2]}
        class="size-8 rounded-md ring-1 ring-white/15"
        loading="eager"
      />
      <span class="font-serif text-lg font-semibold tracking-tight">{site.name}</span>
    </a>
    <nav aria-label="Main" class="flex items-center gap-8">
      <ul class="hidden items-center gap-7 md:flex">
        {site.nav.map((link) => (
          <li>
            <a href={link.href} class="eyebrow text-mist transition-colors hover:text-paper">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <Button href={contactHref} size="sm">
        Contact Us
      </Button>
    </nav>
  </div>
</header>
