---
import { Image } from 'astro:assets';
import logo from '@/assets/images/cebra-partners-logo.webp';
import { site } from '@/config/site';

const trimSlash = (path: string) => path.replace(/\/+$/, '') || '/';
const current = trimSlash(Astro.url.pathname);
---

<header class="px-5 pt-4">
  <nav aria-label="Main" class="flex flex-wrap items-center gap-2">
    <a href="/" class="mr-1 shrink-0" aria-label={`${site.name} home`}>
      <Image src={logo} alt="" width={40} height={40} densities={[1, 2]} class="size-10" loading="eager" />
    </a>
    <ul class="flex flex-wrap gap-2">
      {site.nav.map((item) => {
        const isCurrent = trimSlash(item.href) === current;
        return (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent ? 'page' : undefined}
              class:list={[
                'font-ui block border border-white px-4 py-1.5 text-base tracking-wider text-white transition-colors hover:bg-charcoal',
                isCurrent && 'bg-charcoal',
              ]}
            >
              {item.label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>
