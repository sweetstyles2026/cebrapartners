---
import '@fontsource-variable/epilogue';
import '@fontsource/questrial';
import '@/styles/global.css';

import { getImage } from 'astro:assets';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import { site } from '@/config/site';
import logo from '@/assets/images/cebra-partners-logo.webp';

interface Props {
  /** Page name shown in the browser tab, e.g. "About" -> "About | Cebra Partners". */
  title: string;
  /** Summary for search engines and link previews. Defaults to the site description. */
  description?: string;
}

const { title, description = site.description } = Astro.props;

const pageTitle = `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = await getImage({ src: logo, width: 600, height: 600, format: 'jpg' });
const shareImageUrl = new URL(shareImage.src, Astro.site);

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: Astro.site?.href,
  logo: shareImageUrl.href,
  email: site.email,
  description: site.description,
  areaServed: site.areaServed.map((name) => ({ '@type': 'State', name })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#4940cd" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImageUrl} />
    <meta name="twitter:card" content="summary" />

    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
  </head>
  <body class="font-sans text-white">
    <div class="site-backdrop flex min-h-svh flex-col">
      <a
        href="#main"
        class="font-ui sr-only z-10 bg-white px-4 py-2 text-ink focus:not-sr-only focus:absolute focus:top-4 focus:left-4"
      >
        Skip to content
      </a>
      <SiteHeader />
      <main id="main" class="text-lift flex-1 px-5 sm:px-6">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
