---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/inter';
import '@/styles/global.css';

import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import SeoHead from '@/components/SeoHead.astro';

interface Props {
  /** Page name shown in the browser tab, e.g. "About" -> "About | Cebra Partners". */
  title: string;
  /** Summary for search engines and link previews. Defaults to the site description. */
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SeoHead title={title} description={description} />
  </head>
  <body class="bg-ink font-sans text-fog">
    <a
      href="#main"
      class="sr-only z-50 rounded-full bg-amber px-4 py-2 font-medium text-ink focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
