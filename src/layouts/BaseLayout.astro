---
import '@fontsource-variable/epilogue';
import '@fontsource/questrial';
import '@/styles/global.css';

import SeoHead from '@/components/SeoHead.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';

interface Props {
  /** Page name shown in the browser tab, e.g. "About" -> "About | Cebra Partners". */
  title: string;
  /** Summary for search engines and link previews. Defaults to the site description. */
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SeoHead title={title} description={description} />
  </head>
  <body class="font-sans text-white">
    <div class="site-backdrop flex min-h-svh flex-col">
      <a
        href="#main"
        class="font-ui sr-only z-10 bg-white px-4 py-2 text-ink focus:not-sr-only focus:absolute focus:top-4 focus:left-4"
      >
        Skip to content
      </a>
      <SiteHeader />
      <main id="main" class="text-lift flex-1 px-5 sm:px-6">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
