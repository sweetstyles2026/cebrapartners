---
import Button from '@/components/Button.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you are looking for could not be found.">
  <section class="relative isolate overflow-hidden">
    <img
      src="/images/contours.svg"
      alt=""
      aria-hidden="true"
      class="mask-fade-left pointer-events-none absolute inset-y-0 right-0 -z-10 h-full w-full max-w-[1200px] object-cover object-left opacity-40 md:w-[80%] md:opacity-60"
    />
    <div class="mx-auto max-w-7xl px-5 pt-24 pb-32 sm:px-8 md:pt-36 md:pb-44">
      <p class="eyebrow text-mist">Error 404</p>
      <h1 class="mt-4 font-serif text-[clamp(2.75rem,7vw,5.5rem)] leading-none font-semibold tracking-[-0.03em] text-paper">
        Page not found
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-fog">
        Sorry, we couldn’t find that page. It may have moved, or the link may be incorrect.
      </p>
      <Button href="/" class="mt-10">
        Back to home
      </Button>
    </div>
  </section>
</BaseLayout>
