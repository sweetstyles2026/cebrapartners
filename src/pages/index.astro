---
import { Image } from 'astro:assets';
import caseyField from '@/assets/images/casey-prohaska-field.jpg';
import caseyPortrait from '@/assets/images/casey-prohaska.jpg';
import Button from '@/components/Button.astro';
import { contactHref, site } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';

const pillars = ['Acquire', 'Operate', 'Grow'];
---

<BaseLayout title="Home">
  <!-- Hero -->
  <section id="top" class="relative isolate overflow-hidden">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -top-48 -right-48 -z-10 size-[46rem] rounded-full bg-[radial-gradient(closest-side,rgb(231_145_0/0.2),rgb(73_64_205/0.16)_55%,transparent)] blur-2xl"
    ></div>
    <img
      src="/images/contours.svg"
      alt=""
      aria-hidden="true"
      class="mask-fade-left pointer-events-none absolute inset-y-0 right-0 -z-10 h-full w-full max-w-[1200px] object-cover object-left opacity-40 md:w-[80%] md:opacity-70"
    />

    <div class="mx-auto max-w-7xl px-5 pt-20 pb-24 sm:px-8 md:pt-28 md:pb-32 lg:pt-36 lg:pb-40">
      <p class="eyebrow enter flex items-center gap-3 text-mist">
        <span class="bg-brand-gradient h-px w-10"></span>
        Kansas · Missouri
      </p>
      <h1
        class="enter mt-6 font-serif text-[clamp(3.5rem,11vw,8.75rem)] leading-[0.92] font-semibold tracking-[-0.035em] text-paper"
        style="--delay: 80ms"
      >
        Cebra
        <br />
        Partners
      </h1>
      <p class="enter mt-8 max-w-2xl text-lg leading-relaxed text-fog sm:text-xl" style="--delay: 160ms">
        Cebra Partners is focused on acquiring, operating, and growing privately-owned businesses in Kansas and
        Missouri. Led by a driven entrepreneur and supported by a team of partners and advisors, Cebra Partners is a
        permanent home for great businesses and the teams who lead them.
      </p>
      <div class="enter mt-10 flex flex-wrap gap-3" style="--delay: 240ms">
        <Button href={contactHref}>Contact Us</Button>
        <Button href="#about" variant="ghost" icon="down">
          Meet the founder
        </Button>
      </div>
    </div>
  </section>

  <!-- Acquire / Operate / Grow -->
  <section aria-label="What we do" class="border-y border-white/10 bg-ink-2">
    <ol class="mx-auto grid max-w-7xl divide-y divide-white/10 px-5 sm:grid-cols-3 sm:divide-x sm:divide-y-0 sm:px-8">
      {pillars.map((word, i) => (
        <li class="reveal flex items-baseline gap-4 py-7 sm:px-8 sm:py-10 sm:first:pl-0">
          <span class="text-xs font-semibold text-amber tabular-nums">0{i + 1}</span>
          <span class="font-serif text-3xl font-medium tracking-tight text-paper md:text-4xl">{word}</span>
        </li>
      ))}
    </ol>
  </section>

  <!-- About -->
  <section id="about" aria-labelledby="about-title" class="bg-paper text-body">
    <div class="mx-auto grid max-w-7xl gap-16 px-5 py-24 sm:px-8 md:py-32 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-5">
        <figure class="reveal relative mr-10 sm:mr-24 lg:sticky lg:top-28 lg:mr-14">
          <Image
            src={caseyField}
            alt="Casey Prohaska in a hard hat and coveralls at an oilfield processing facility"
            widths={[400, 640, 800]}
            sizes="(min-width: 1024px) 32vw, 85vw"
            class="aspect-[4/5] w-full rounded-2xl object-cover object-[50%_60%] shadow-2xl shadow-ink/20"
          />
          <Image
            src={caseyPortrait}
            alt="Portrait of Casey Prohaska"
            widths={[160, 240, 352, 400]}
            sizes="(min-width: 640px) 11rem, 8rem"
            class="absolute -right-10 -bottom-10 aspect-square w-32 rounded-2xl object-cover shadow-xl ring-8 ring-paper sm:-right-16 sm:w-44"
          />
        </figure>
      </div>

      <div class="lg:col-span-7">
        <p class="eyebrow text-violet">About the founder</p>
        <h2
          id="about-title"
          class="mt-4 font-serif text-5xl leading-none font-semibold tracking-[-0.025em] text-ink md:text-6xl"
        >
          Casey Prohaska
        </h2>

        <div class="mt-10 max-w-[65ch] space-y-6 text-lg leading-relaxed">
          <p class="text-xl leading-relaxed text-ink">
            Casey Prohaska, Founder of Cebra Partners, is a Kansas native who brings experience leading operations,
            teams, and business growth across the energy and technology industries. She is seeking to acquire a business
            where she can take an active role in its day-to-day leadership and build on the owner’s legacy.
          </p>
          <p>
            Casey began her career in the Texas oilfields, living in a remote workforce camp without cell service. Her
            commitment to keeping operations running later led her to sleeping in a truck waiting for a critical part,
            with an oilfield just one day away from shutdown and later, following a 10,000 acre wildfire, she was the
            first person to enter the affected area after clearance from the state fire marshal, leading the team that
            developed and executed the plan to bring the oilfield back into operation. These experiences reflect the
            work that energizes her most: being on the ground, taking responsibility, and working alongside a team to
            solve problems.
          </p>

          <!-- Pull line repeats the sentence above, so it's hidden from screen readers. -->
          <p
            aria-hidden="true"
            class="reveal my-12 border-l-2 border-amber py-1 pl-6 font-serif text-2xl leading-snug text-ink sm:text-3xl"
          >
            Being on the ground, taking responsibility, and working alongside a team to solve problems.
          </p>

          <p>
            Throughout her career, Casey has led a 90-person operations team and held leadership roles focused on
            customer relationships and business growth. She brings respect for frontline expertise, a willingness to
            learn the details, and a hands-on approach to leadership.
          </p>
          <p>
            Casey earned a Master of Business Administration (MBA) from Stanford Graduate School of Business and a
            bachelor’s degree in Chemical Engineering from the University of Kansas.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" aria-labelledby="contact-title" class="relative isolate overflow-hidden">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -bottom-64 -left-48 -z-10 size-[44rem] rounded-full bg-[radial-gradient(closest-side,rgb(73_64_205/0.22),rgb(231_145_0/0.12)_60%,transparent)] blur-2xl"
    ></div>
    <div class="mx-auto max-w-7xl px-5 py-24 sm:px-8 md:py-36">
      <div class="bg-brand-gradient h-0.5 w-24"></div>
      <p class="eyebrow mt-8 text-mist">Contact</p>
      <h2
        id="contact-title"
        class="mt-4 font-serif text-[clamp(2.75rem,7vw,5.5rem)] leading-none font-semibold tracking-[-0.03em] text-paper"
      >
        Let’s talk.
      </h2>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-fog">
        {site.name} is a permanent home for great businesses and the teams who lead them.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-5">
        <Button href={contactHref}>Contact Us</Button>
        <a
          href={`mailto:${site.email}`}
          class="text-lg text-paper underline decoration-amber decoration-2 underline-offset-8 transition-colors hover:decoration-paper"
        >
          {site.email}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
